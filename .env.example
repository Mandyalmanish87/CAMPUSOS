# CampusOS environment configuration
# Copy this file to .env and edit as needed.
# The app reads these from config.py — no .env auto-loading, just reference.

# Absolute path to the SQLite database file.
# Default: campusos.db in the project root.
# CAMPUSOS_DB_PATH=C:\Users\mandy\Downloads\CampusOS\CampusOS\campusos.db

# Ollama server base URL (used for Gemma AI inference).
# Default: http://127.0.0.1:11434
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gemma model name as listed in Ollama (ollama list).
# Default: gemma4:e4b
# GEMMA_MODEL_NAME=gemma4:e4b

# AI inference timeout in seconds.
# Increase this if your machine is slow or the model is not warmed up.
# Default: 120
# AI_TIMEOUT_SECONDS=120
